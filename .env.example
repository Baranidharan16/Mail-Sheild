# MailShield backend configuration. Copy to backend/.env for local development.
# NEVER commit backend/.env. In production set these in the Render dashboard.

# --- Environment -------------------------------------------------------------
APP_ENV=development                # production on Render
LOAD_ML_MODELS=true                # false on small instances (Render free = 512 MB)

# --- Database (ONE shared database for all users/devices) --------------------
# Local:      sqlite:///./forensics.db
# Production: postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require   (Neon / Supabase / external Postgres)
DATABASE_URL=sqlite:///./forensics.db

# --- Authentication ------------------------------------------------------------
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-a-random-string-of-at-least-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
COOKIE_SAMESITE=lax                # "none" only if frontend calls the backend cross-site
# COOKIE_SECURE=true               # auto-true when APP_ENV=production

# --- Frontend / CORS -------------------------------------------------------------
# Local:      http://localhost:5173
# Production: https://mailshield-sih.onrender.com
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Google OAuth (Gmail) --------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Local:      http://localhost:8000/auth/google/callback
# Production: https://sih-email-forensics-full-1.onrender.com/auth/google/callback
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# --- AI providers (optional) -------------------------------------------------------
GEMINI_API_KEY=
SARVAM_API_KEY=
REASONING_PROVIDER=gemini

# --- Misc ------------------------------------------------------------------------------
UPLOAD_STORAGE_DIR=./storage/evidence
MAX_UPLOAD_SIZE_BYTES=10485760
RATE_LIMIT_PER_MINUTE=600
TRUSTED_ORG_DOMAINS=[]

# --- Real-time Gmail monitor -----------------------------------------------------------
GMAIL_MONITOR_ENABLED=true
GMAIL_POLL_INTERVAL_SECONDS=60
GMAIL_AUTO_QUARANTINE=false
DATA_RETENTION_DAYS=90

# --- Postgres (docker-compose only; ignored by Render / plain local runs) --------------
POSTGRES_USER=forensics
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=email_forensics

# --- Hyperledger Fabric evidence ledger (optional; leave as-is if not running Fabric) --
FABRIC_NETWORK=local-dev
FABRIC_CHANNEL=forensicschannel
FABRIC_CHAINCODE=evidence_cc
FABRIC_MSP_ID=Org1MSP
FABRIC_PEER_ENDPOINT=localhost:7051

# Frontend: VITE_API_BASE_URL lives in frontend/.env.development / .env.production,
# not here (the Docker build sets it to /api/v1 automatically).

# --- Isolated sandbox + advanced pipeline (quarantine -> sandbox -> GRC/VAPT -> report -> ledger -> SOC alarm)
# URL of the separate sandbox service (docker-compose: http://sandbox:8080; Render: https://mailshield-sandbox.onrender.com;
# plain local run: start `uvicorn sandbox_app.main:app --port 8090` in sandbox/ and use http://127.0.0.1:8090)
SANDBOX_URL=
# Shared HMAC secret — MUST be identical on the backend and the sandbox. Generate:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SANDBOX_SHARED_SECRET=
SANDBOX_ENABLED=true
SANDBOX_TIMEOUT_SECONDS=90
SANDBOX_MAX_RETRIES=4
ADVANCED_PIPELINE_ENABLED=true

# --- Google OAuth brand verification (public home page) ---
APP_PUBLIC_NAME=MailShield
GOOGLE_SITE_VERIFICATION=
CONTACT_EMAIL=
